# Copy to .env (never commit .env). On the droplet this file lives at
# /etc/detector-backend/env, owned by root and readable only by the service user.

# Sightengine credentials (https://dashboard.sightengine.com/api-credentials).
# Without both values the service starts but POST /v1/check answers 503.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Listen on loopback only; Caddy or nginx terminates HTTPS in front of the service.
HOST=127.0.0.1
PORT=8787

# Trust X-Forwarded-For from the local reverse proxy so rate limits see the real client IP.
TRUST_PROXY=127.0.0.1

# Daily cap on provider checks (REQ-NF-005). A check costs 10 operations (genai plus deepfake,
# measured 2026-11-21), so 100 checks is 1,000 operations a day. The free tier allows 500 a
# day and 2,000 a month; heavy use goes over it.
DAILY_CAP=100
